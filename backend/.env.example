# Copy this file to backend/.env for local development and fill in the values.
# backend/.env is git-ignored: never commit real keys. On Render, set these as Environment Variables instead.

# The Movie Database key for the admin "Import from TMDB" page (free):
# themoviedb.org -> log in -> Settings -> API -> request an API key.
# Either the "API Key" (v3, 32 characters) or the "API Read Access Token" (v4, starts with eyJ) works.
TMDB_API_KEY=

# Production only (see DEPLOY.md) - leave commented out for local development:
# SECRET_KEY=a-long-random-string
# DEBUG=False
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
